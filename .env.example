# GEMINI_API_KEY: Required for Gemini AI features.
# Injected automatically at runtime from AI Studio secrets or environment variables.
GEMINI_API_KEY=

# APP_URL: The public base URL where this applet is hosted.
# Injected automatically at runtime by Cloud Run.
APP_URL=

# AWS S3 Configuration (Optional - app defaults to built-in local storage buffer)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
